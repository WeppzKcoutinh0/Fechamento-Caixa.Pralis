# Variáveis de ambiente do app (client + build). Copie para `.env` localmente, ou configure
# na Vercel em Project Settings → Environment Variables.
#
# São as únicas duas necessárias em produção — ambas seguras para expor no navegador
# (a chave é a pública/anon; toda regra de acesso real vive na RLS do Supabase, nunca aqui).

NUXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NUXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-publica

# As variáveis abaixo NUNCA vão para a Vercel nem para o client — servem só para eu (ou você)
# rodar migrations via Supabase CLI localmente. Nunca use SUPABASE_DB_PASSWORD/ACCESS_TOKEN
# em nenhuma variável de ambiente do deploy.

# --- Integração de vendas (CREARE) — server-only, usadas por server/api/integracoes/** ---
# Estas DUAS vão para a Vercel, mas como variável de ambiente do SERVIDOR (nunca marcar como
# "public"/NUXT_PUBLIC_ — o Nitro roda essa rota só no servidor, o valor nunca chega ao navegador).
#
# Chave service_role do Supabase (Project Settings → API). Só a rota de ingestão de vendas usa —
# ela ignora RLS de propósito, por isso nunca deve ir para NUXT_PUBLIC_*.
NUXT_SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta
# Segredo compartilhado com o agente local (integracoes-scripts/.env) — gere algo aleatório e longo
# (ex.: `openssl rand -hex 32`). O agente manda no header `x-api-key`.
NUXT_INTEGRACAO_VENDAS_CHAVE=gere-um-segredo-aleatorio-longo

# --- Leitura de relatório de maquininha por IA (server-only) ---
# A rota usa o formato compatível com OpenAI Chat Completions e aceita gateways compatíveis.
# A chave nunca deve usar o prefixo NUXT_PUBLIC_.
NUXT_AI_VISION_API_KEY=chave-secreta-do-provedor
NUXT_AI_VISION_BASE_URL=https://api.openai.com/v1
NUXT_AI_VISION_MODEL=nome-do-modelo-com-visao
