# Copie para .env.producao (que fica FORA do git) na máquina da loja e preencha.
#
# Mesmos nomes de variável do bot_padaria_v3 já em produção (ver
# app/PRALIS-INTELIGENTE DESIGNER/bot.rar) — se você já tem um .env.producao daquele bot rodando
# nesta mesma loja, as 5 primeiras linhas (CREARE) são as MESMAS, é só copiar.

# --- Banco do CREARE/Compilart (MySQL/MariaDB, na própria loja) --- só usado por
# `npm run sincronizar`/`npm run agente` (leitura direta do CREARE). Não precisa preencher se
# você só vai usar `npm run importar-planilha` (ver seção GOOGLE abaixo).
SERVIDOR_CREARE_COMPILART="localhost"
PORTA_CREARE_COMPILART="3306"
BANCO_CREARE_COMPILART="gerente"
USUARIO_CREARE_COMPILART="root"
SENHA_CREARE_COMPILART=""

# --- Empresa (usado só pra rotular as linhas — coluna EMPRESA) ---
EMPRESA="TNP CENTRAL"

# --- Planilha Google (só pra `npm run importar-planilha`) ---
# Caminho alternativo ao CREARE direto: lê a MESMA planilha que o bot_padaria_v3 original já
# preenche (útil enquanto não há uma máquina rodando na LAN da loja). Precisa da chave da service
# account que o bot original já usa pra ESCREVER nessa planilha (ela também pode ler) — o arquivo
# .json fica FORA do git/OneDrive, referencie o caminho completo aqui.
GOOGLE_SERVICE_ACCOUNT_FILE=""
GOOGLE_SPREADSHEET_ID=""
# Só preencha se VENDAS_PRODUTOS foi movido pra planilha secundária (ver config.yaml do bot
# original, ABAS_EM_PLANILHA_SECUNDARIA) — se não souber, deixe em branco.
GOOGLE_SPREADSHEET_ID_SECUNDARIO=""
# A partir de qual coluna a planilha tem dados (o bot original sempre escreve a partir da F).
COLUNA_INICIAL="F"

# --- App Pralis (na internet) e chave de integração ---
PRALIS_VENDAS_API_URL="https://SEU-APP.vercel.app"
# Mesmo valor de NUXT_INTEGRACAO_VENDAS_CHAVE configurado no app (Vercel/​app/.env).
PRALIS_VENDAS_API_TOKEN=""

# --- Sincronização (opcionais; defaults entre colchetes) ---
# Intervalo entre ciclos no modo loop (npm run agente).
SYNC_INTERVALO_MINUTOS="10"
# Cada ciclo relê do CREARE desde "hoje menos N dias" pra cá (o servidor deduplica por HASH,
# então reprocessar é sempre seguro — é só assim que um fechamento tarde ou uma correção no CREARE
# ainda entra).
SYNC_DIAS_REPROCESSAR="3"
# Idade máxima do lock antes de considerá-lo obsoleto e poder roubá-lo.
SYNC_LOCK_MAX_MINUTOS="30"
# Retry de rede por lote enviado.
SYNC_RETRY_TENTATIVAS="4"
SYNC_RETRY_BASE_MS="500"
# Também enviar o resumo por produto/dia (tabela vendas_produto_dia)? "true"/"false".
SYNC_ENVIAR_PRODUTOS="true"
# Pasta do estado de runtime (lote pendente + lock). Relativa ao workspace por padrão.
SYNC_ESTADO_DIR=".estado"
